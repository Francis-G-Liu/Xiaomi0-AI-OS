		2) ui_print "- 你选择了 <Magisk>";;
		3) ui_print "- 你选择了 <APatch>";;
		4) ui_print "- 你选择了 <FolkPatc>";;
		5) ui_print "- 你选择了 <KernelSU>";;
		6) ui_print "- 你选择了 <SukiSU-Ultra>";;
