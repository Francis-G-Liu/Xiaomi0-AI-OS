OUTFD=/proc/self/fd/$2
ZIPFILE="$3"

ui_print() {
  echo -e "ui_print $1\nui_print" >>$OUTFD
}

package_extract_file() {
  ui_print "- 正在刷写分区 $(echo $2 | cut -d '/' -f 6) "
  /tmp/bin/android/7zzs e -so "$ZIPFILE" $1 > $2
}

package_extract_zstd() {
  ui_print "- 正在刷写分区 $(echo $2 | cut -d '/' -f 6) "
  /tmp/bin/android/7zzs e -so "$ZIPFILE" $1 | /tmp/bin/android/zstd -c -d > $2
}

getVolumeKey() {
	ui_print "- 监听音量键 按[+]选择"是" 按[-]选择"否""
	keyInfo=true
	while $keyInfo;do
		keyInfo=$(getevent -qlc 1 |grep KEY_VOLUME)
		if [ "$keyInfo" == "" ];then
			continue
		else
			isUpKey=$(echo $keyInfo |grep KEY_VOLUMEUP)
			[ "$isUpKey" != "" ] && return 0 || return 1
			break
		fi
	done
}

