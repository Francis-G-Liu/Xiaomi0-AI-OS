select_flash_root() {
	local type
	ui_print " "
	ui_print " "
	ui_print "======请选择root方式======="
	ui_print " "
	ui_print "   <1> 不root"
	ui_print "   <2> Magisk"
	ui_print "   <3> APatch"
	ui_print "   <4> FolkPatch"
	ui_print "   <5> KernelSU"
	ui_print "   <6> SukiSU-Ultra"
	ui_print "   <7> KernelSU-Next"
	ui_print "   <8> Kitsune Mask"
	ui_print " "
	ui_print "========================="
	select=0
	type=不root
	local key_file key_pid key_line idle_seconds confirmed
	key_file="/tmp/root-selector-$$.events"
	: > "$key_file"
	getevent -ql > "$key_file" 2>/dev/null &
	key_pid=$!
	idle_seconds=0
	confirmed=0
	ui_print " "
	ui_print "- 按音量[-]切换，按音量[+]确定"
	ui_print "- 当前选择：不root（默认）"
	ui_print "- 8 秒无操作自动确认当前选项；切换后重新计时"
	ui_print " "
	# 持续监听到普通文件，读取到文件末尾不会阻塞计时。
	while [ "$confirmed" -eq 0 ]; do
		while IFS= read -r key_line; do
			# 只处理按下事件，忽略松开和长按重复事件。
			case "$key_line" in
				*KEY_VOLUMEDOWN*DOWN*)
					select=$((select + 1))
					[ "$select" -gt 8 ] && select=1
					case "$select" in
						1) type=不root ;;
						2) type=Magisk ;;
						3) type=APatch ;;
						4) type=FolkPatch ;;
						5) type=KernelSU ;;
						6) type=SukiSU-Ultra ;;
						7) type=KernelSU-Next ;;
						8) type="Kitsune Mask" ;;
					esac
					idle_seconds=0
					ui_print "- 当前选择：${select} ==> ${type}"
					ui_print "- 8 秒无操作后自动确认"
					ui_print " "
					;;
				*KEY_VOLUMEUP*DOWN*)
					confirmed=1
					break
					;;
			esac
		done
		[ "$confirmed" -eq 1 ] && break
		if [ "$idle_seconds" -ge 8 ]; then
			ui_print " "
			ui_print " "
			ui_print " "
			ui_print "- 8 秒无操作，自动确认：${type}"
			ui_print " "
			break
		fi
		sleep 1
		idle_seconds=$((idle_seconds + 1))
	done < "$key_file"
	kill "$key_pid" 2>/dev/null
	wait "$key_pid" 2>/dev/null
	rm -f "$key_file"
	getRootTypePrint ${select}
	package_extract_file "images/boot_official.img" "/dev/block/bootdevice/by-name/boot_a"
	package_extract_file "images/boot_official.img" "/dev/block/bootdevice/by-name/boot_b"
	if [ ${select} -eq 2 ];then
		# Magisk
		ui_print "- Patch Magisk, target => boot_magisk.img"
		package_extract_file "images/boot_magisk.img" "/dev/block/bootdevice/by-name/boot_a"
		package_extract_file "images/boot_magisk.img" "/dev/block/bootdevice/by-name/boot_b"
	elif [ ${select} -eq 3 ];then
		# APatch
		ui_print "- Patch APatch, target => boot_apatch.img"
		package_extract_file "images/boot_apatch.img" "/dev/block/bootdevice/by-name/boot_a"
		package_extract_file "images/boot_apatch.img" "/dev/block/bootdevice/by-name/boot_b"
	elif [ ${select} -eq 4 ];then
		# FolkPatch
		ui_print "- Patch FolkPatch, target => boot_folkpatch.img"
		package_extract_file "images/boot_folkpatch.img" "/dev/block/bootdevice/by-name/boot_a"
		package_extract_file "images/boot_folkpatch.img" "/dev/block/bootdevice/by-name/boot_b"
	elif [ ${select} -eq 5 ];then
		# KernelSU
		ui_print "- Patch KernelSU, target => boot_ksu.img"
		package_extract_file "images/boot_ksu.img" "/dev/block/bootdevice/by-name/boot_a"
		package_extract_file "images/boot_ksu.img" "/dev/block/bootdevice/by-name/boot_b"
	elif [ ${select} -eq 6 ];then
		# SukiSU-Ultra
		ui_print "- Patch SukiSU-Ultra, target => boot_sukisu.img"
		package_extract_file "images/boot_sukisu.img" "/dev/block/bootdevice/by-name/boot_a"
		package_extract_file "images/boot_sukisu.img" "/dev/block/bootdevice/by-name/boot_b"
	elif [ ${select} -eq 7 ];then
		# KernelSU-Next
		ui_print "- Patch KernelSU-Next, target => boot_ksu-next.img"
		package_extract_file "images/boot_ksu-next.img" "/dev/block/bootdevice/by-name/boot_a"
		package_extract_file "images/boot_ksu-next.img" "/dev/block/bootdevice/by-name/boot_b"
	elif [ ${select} -eq 8 ];then
		# Kitsune Mask
		ui_print "- Patch Kitsune Mask, target => boot_kitsune-mask.img"
		package_extract_file "images/boot_kitsune-mask.img" "/dev/block/bootdevice/by-name/boot_a"
		package_extract_file "images/boot_kitsune-mask.img" "/dev/block/bootdevice/by-name/boot_b"
	fi
}

